// --- Prisma スキーマ定義 ---
// DBファースト設計に基づき、すべてのデータはここで一元管理する。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // DATABASE_URL は .env から注入する（ハードコード禁止）
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ニュース記事テーブル ---
// ワークフロー: pending → summarized → posted
// statusによって次の処理対象を絞り込み、重複処理を防ぐ（CLAUDE.md §4-2参照）
model Article {
  id        String   @id @default(cuid())
  url       String   @unique // URLはRFC的に一意。重複保存防止のキーとして使用
  title     String
  content   String?
  summary   String?  // Gemini による要約結果
  status    Status   @default(pending)
  source    String?  // ニュースソース名
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- ステータス定義 ---
// C# の enum に相当（Prisma の enum 型）
enum Status {
  pending    // 取得済み・未処理
  summarized // AI要約済み
  posted     // 外部投稿済み
  error      // 処理エラー（再試行対象）
}
